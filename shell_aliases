claude() {
    local dir="$PWD" agent=""
    if [[ "$dir" == */Projects/haak* ]]; then
        local haak_root="${dir%%/Projects/haak/*}/Projects/haak"
        while [[ "$dir" == "$haak_root"/* || "$dir" == "$haak_root" ]]; do
            if [[ -f "$dir/.haak/agent" ]]; then
                agent="$(<"$dir/.haak/agent")"
                break
            fi
            dir="${dir%/*}"
        done
        # Extract --agent override from args
        local resolved_agent="${agent:-haak}"
        local arg_prev=""
        for arg in "$@"; do
            if [[ "$arg_prev" == "--agent" ]]; then
                resolved_agent="$arg"
            fi
            arg_prev="$arg"
        done
        # Record breadcrumb: CWD + agent + TTY + timestamp
        # zed-recover reads this to match terminals to sessions
        local crumb_file="$HOME/.claude/terminal-breadcrumbs"
        printf '%s\t%s\t%s\t%s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$PWD" "$resolved_agent" "$(tty 2>/dev/null || echo unknown)" >> "$crumb_file" 2>/dev/null
        command claude --agent "${agent:-haak}" "$@"
    else
        command claude "$@"
    fi
}
